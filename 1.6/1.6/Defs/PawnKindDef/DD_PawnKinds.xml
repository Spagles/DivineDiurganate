	<!-- sp -->
	<PawnKindDef ParentName="RKBasePawnKind">
		<defName>DD_Maple_Sugar</defName>
		<label>Maple Sugar</label>
		<fixedGender>Female</fixedGender>
		<defaultFactionDef>PlayerColony</defaultFactionDef>
		<combatPower>55</combatPower>
		<minGenerationAge>20</minGenerationAge>
		<maxGenerationAge>22</maxGenerationAge>
		<isFighter>true</isFighter>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<!-- <backstoryCryptosleepCommonality>0.05</backstoryCryptosleepCommonality> -->
		<nameMaker>DD_Maple_Sugar_NameMaker</nameMaker>
		<fixedChildBackstories>
			<li>Ratkin_Orphan</li>
		</fixedChildBackstories>
		<fixedAdultBackstories>
			<li>DD_Ratkin_Sister</li>
		</fixedAdultBackstories>
		<xenotypeSet>
			<xenotypeChances>
				<Baseliner>1</Baseliner>
				<Ratkin_HouseMouse MayRequire="EoralMilk.RatkinGeneExpanded">9999</Ratkin_HouseMouse>
			</xenotypeChances>
		</xenotypeSet>
		<forcedHair>DD_Maple_Sugar_Hair</forcedHair>
		<forcedHairColor>(1,1,1,1)</forcedHairColor>
		<requiredWorkTags>
			<li>Violent</li>
			<li>Caring</li>
		</requiredWorkTags>
		<invNutrition>10.0</invNutrition>
		<inventoryOptions>
			<subOptionsChooseOne>
				<li>
					<thingDef>MedicineIndustrial</thingDef>
					<countRange>5</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>
		<gearHealthRange>1~1</gearHealthRange>
		<itemQuality>Good</itemQuality>
		<weaponMoney>99999~99999</weaponMoney>
		<apparelRequired>
			<li>DD_Nun_Dress</li>
			<li>DD_NunVeil</li>
			<li>DD_Maple_Sugar_PackLoudspeaker</li>
		</apparelRequired>
		<weaponTags>
			<li>DD_Maple_Sugar_Weapon</li>
		</weaponTags>
		<apparelTags>
			<li>IndustrialBasic</li>
			<li>IndustrialAdvanced</li>
		</apparelTags>
		<forcedTraits>
			<Bloodlust>0</Bloodlust>
			<Gay>0</Gay>
			<Beauty>1</Beauty>
		</forcedTraits>
		<ignoreIdeoApparelColors>true</ignoreIdeoApparelColors>
		<initialWillRange>0~0</initialWillRange>
		<initialResistanceRange>0~2</initialResistanceRange>
		<humanPregnancyChance>0</humanPregnancyChance>
		<abilities>
			<li>DD_Maple_Sugar_Heal</li>
		</abilities>

		<modExtensions>
			<li Class="DivineDiurganate.HeadTypeExtension">
				<!-- 设置头部类型 -->
				<forcedHeadTypeDef>DD_Maple_Sugar_Head</forcedHeadTypeDef>
			</li>
			<li Class="DivineDiurganate.PawnKindExtension_EyeballOverride">
				<eyeballTypeDefNames>
					<li>DD_Maple_Sugar_Eyeball</li>					<!-- 直接指定Def名称 -->
				</eyeballTypeDefNames>
			</li>
		</modExtensions>
	</PawnKindDef>
	<HairDef>
		<defName>DD_Maple_Sugar_Hair</defName>
		<label>Hair of Maple Sugar</label>
		<hairGender>Female</hairGender>
		<texPath>DivineDiurganate/Hair/DD_Maple_Sugar_Hair</texPath>
		<!-- <category>RK_Style</category>
		<styleTags>
			<li>RK_Style</li>
		</styleTags> -->
	</HairDef>
	<RulePackDef>
		<defName>DD_Maple_Sugar_NameMaker</defName>
		<include>
			<li>RatkinKingdomNameUtility</li>
		</include>
		<rulePack>
			<rulesStrings>
				<li>r_name->[DD_Maple_Sugar_FirstName] '[DD_Maple_Sugar_nickName]' [DD_Maple_Sugar_LastName]</li>
				<li>DD_Maple_Sugar_nickName->MapleSugar</li>
				<li>DD_Maple_Sugar_FirstName->Flavia</li>
				<li>DD_Maple_Sugar_LastName->Whitemane</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>
	<HeadTypeDef ParentName="AverageBase">
		<defName>DD_Maple_Sugar_Head</defName>
		<graphicPath>DivineDiurganate/Head/DD_Maple_Sugar_Head</graphicPath>
		<gender>None</gender>
		<randomChosen>false</randomChosen>
	</HeadTypeDef>
	<FacialAnimation.EyeballTypeDef MayRequire="Nals.FacialAnimation">
		<defName>DD_Maple_Sugar_Eyeball</defName>
		<texPath>DivineDiurganate/Eyes/Maple_Sugar</texPath>
		<altMaskPath>Things/Pawn/FA-Experimentals/Eyes/Common</altMaskPath>
		<raceName>Ratkin</raceName>
		<shader>Map/CutoutSkinOverlay</shader>
		<minColor>(0.99,0.99,0.99,1)</minColor>
		<maxColor>(1,1,1,1)</maxColor>
		<probability>0.0001</probability>
	</FacialAnimation.EyeballTypeDef>

