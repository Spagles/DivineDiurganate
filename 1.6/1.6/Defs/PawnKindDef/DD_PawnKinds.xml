	<!-- sp -->
	<PawnKindDef ParentName="RKBasePawnKind">
		<defName>DD_Maple_Sugar</defName>
		<label>Maple Sugar</label>
		<fixedGender>Female</fixedGender>
		<defaultFactionDef>PlayerColony</defaultFactionDef>
		<combatPower>55</combatPower>
		<minGenerationAge>21</minGenerationAge>
		<maxGenerationAge>22</maxGenerationAge>
		<isFighter>true</isFighter>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<!-- <backstoryCryptosleepCommonality>0.05</backstoryCryptosleepCommonality> -->
		<nameMaker>DD_Maple_Sugar_NameMaker</nameMaker>
		<fixedChildBackstories>
			<li>DD_Ratkin_Nobel_Child</li>
		</fixedChildBackstories>
		<fixedAdultBackstories>
			<li>DD_Ratkin_Idol_Sister</li>
		</fixedAdultBackstories>
		<xenotypeSet>
			<xenotypeChances>
				<Baseliner>1</Baseliner>
				<Ratkin_HouseMouse MayRequire="EoralMilk.RatkinGeneExpanded">9999</Ratkin_HouseMouse>
			</xenotypeChances>
		</xenotypeSet>
		<forcedHair>DD_Maple_Sugar_Hair</forcedHair>
		<forcedHairColor>(1,1,1,1)</forcedHairColor>
		<invNutrition>10.0</invNutrition>
		<inventoryOptions>
			<subOptionsChooseOne>
				<li>
					<thingDef>MedicineIndustrial</thingDef>
					<countRange>5</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>
		<gearHealthRange>1~1</gearHealthRange>
		<itemQuality>Good</itemQuality>
		<weaponMoney>99999~99999</weaponMoney>
		<apparelRequired>
			<li>DD_Nun_Dress</li>
			<li>DD_NunVeil</li>
			<li>DD_Maple_Sugar_PackLoudspeaker</li>
		</apparelRequired>
		<weaponTags>
			<li>DD_Maple_Sugar_Weapon</li>
		</weaponTags>
		<apparelTags>
			<li>IndustrialBasic</li>
			<li>IndustrialAdvanced</li>
		</apparelTags>
		<forcedTraits>
			<Gay>0</Gay>
		</forcedTraits>
		<ignoreIdeoApparelColors>true</ignoreIdeoApparelColors>
		<initialWillRange>0~0</initialWillRange>
		<initialResistanceRange>0~2</initialResistanceRange>
		<humanPregnancyChance>0</humanPregnancyChance>
		<abilities>
			<li>DD_Maple_Sugar_Heal</li>
		</abilities>

		<modExtensions>
			<li Class="DivineDiurganate.HeadTypeExtension">
				<!-- 设置头部类型 -->
				<forcedHeadTypeDef>DD_Maple_Sugar_Head</forcedHeadTypeDef>
			</li>
			<li Class="DivineDiurganate.PawnKindExtension_EyeballOverride">
				<eyeballTypeDefNames>
					<li>DD_Maple_Sugar_Eyeball</li>					<!-- 直接指定Def名称 -->
				</eyeballTypeDefNames>
			</li>
      <li Class="DivineDiurganate.TraitFilterExtension">
        <keepBackstoryTraits>true</keepBackstoryTraits>
        <keepPawnKindTraits>true</keepPawnKindTraits>
        <allowRandomTraits>false</allowRandomTraits>
        <exceptions>
          <!-- <li>Kind</li>
          <li>Industrious</li> -->
        </exceptions>
      </li>
		</modExtensions>
	</PawnKindDef>
	<HairDef>
