<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AbilityDef>
    <defName>DD_Suicide_Attack</defName>
    <label>Sacrifice</label>
    <description>Ah, what a wonderful day, what a wonderful day! Witness me, live, die, live again, until I am embraced by HIM, witness!!!</description>
    <iconPath>DivineDiurganate/UI/Abilities/DD_Suicide_Attack</iconPath>
    <aiCanUse>true</aiCanUse>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <!-- <targetRequired>False</targetRequired> -->
    <cooldownTicksRange>1</cooldownTicksRange>
    <stunTargetWhileCasting>true</stunTargetWhileCasting>
    <jobDef>CastAbilityOnThingMelee</jobDef>
    <verbProperties>
      <verbClass>Verb_CastAbilityTouch</verbClass>
      <drawAimPie>false</drawAimPie>
      <range>-1</range>
      <warmupTime>0.1</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="DivineDiurganate.CompProperties_AbilityDestroyOwnBodyPart">
        <bodyPartsToDestroy>
          <li>Torso</li>
        </bodyPartsToDestroy>
      </li>
      <li Class="CompProperties_AbilityExplosion">
        <damageAmount>30</damageAmount>
        <damageDef>Bomb</damageDef>
        <explosionRadius>4.9</explosionRadius>
        <armorPenetration>2</armorPenetration>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>DD_Harpoon_Gun_Launch_Harpoon</defName>
    <label>Launch Harpoon</label>
    <description>Using the pneumatic launcher, launch a powerful Harpoon – but before reloading, the weapon can only be used as a close combat weapon.</description>
    <iconPath>DivineDiurganate/Mote/DD_Spear_Rifle_Bullet</iconPath>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>34.9</range>
      <warmupTime>1</warmupTime>
      <soundCast>DD_Harpoon_Gun_FireSound</soundCast>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>DD_Harpoon_Gun_Bullet</projectileDef>
      </li>
    </comps>
  </AbilityDef>
  <ThingDef ParentName="BaseBullet">
    <defName>DD_Harpoon_Gun_Bullet</defName>
    <label>Harpoon</label>
    <graphicData>
      <texPath>DivineDiurganate/Mote/DD_Harpoon_Gun_Proj</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- <shaderType>MoteGlow</shaderType>
      <color>(194,117,67)</color> -->
    </graphicData>
    <projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>25</damageAmountBase>
			<stoppingPower>5</stoppingPower>
			<armorPenetrationBase>0.75</armorPenetrationBase>
			<speed>75</speed>
    </projectile>
  </ThingDef>
  
  <AbilityDef>
    <defName>DD_Maple_Sugar_Heal</defName>
    <label>Holy Heal</label>
    <description>Move to target , pray to the holy Twin-Tail to heal their wounds . There should be no side effects.</description>
    <iconPath>DivineDiurganate/UI/Abilities/DD_Maple_Sugar_Heal</iconPath>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <cooldownTicksRange>1</cooldownTicksRange>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>4.9</range>
      <warmupTime>0</warmupTime>
      <targetParams>
        <onlyTargetColonistsOrPrisonersOrSlaves>true</onlyTargetColonistsOrPrisonersOrSlaves>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="DivineDiurganate.CompProperties_AbilityStartHealingJob"/>
    </comps>
  </AbilityDef>

  <!-- =========================================== -->
  <!-- Hediff抽卡技能示例 -->
  <!-- 使用 CompAbilityEffect_HediffGacha 组件 -->
  <!-- =========================================== -->
  <AbilityDef>
    <defName>DD_Holy_Blessing_Gacha</defName>
    <label>Holy Blessing</label>
    <description>Pray to the Holy Twin-Tail to bestow a random blessing upon the target. The faithful will receive one of three possible divine blessings chosen by the gods.</description>
    <iconPath>DivineDiurganate/UI/Abilities/DD_Maple_Sugar_Heal</iconPath>
    <displayOrder>210</displayOrder>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>30000</cooldownTicksRange> <!-- 半天冷却 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9.9</range>
      <warmupTime>1.5</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>true</canTargetAnimals>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- Hediff抽卡组件配置 -->
      <li Class="DivineDiurganate.CompProperties_AbilityHediffGacha">
        <!-- Hediff池配置 - 每个条目包含hediff和权重 -->
        <hediffPool>
          <li>
            <hediff>DD_GachaBuff_Strength</hediff>
            <weight>1.0</weight>
          </li>
          <li>
            <hediff>DD_GachaBuff_Agility</hediff>
            <weight>1.0</weight>
          </li>
          <li>
            <hediff>DD_GachaBuff_Fortitude</hediff>
            <weight>1.0</weight>
          </li>
          <li>
            <hediff>DD_GachaBuff_Wisdom</hediff>
            <weight>0.8</weight>  <!-- 权重较低，出现概率稍低 -->
          </li>
          <li>
            <hediff>DD_GachaBuff_Vitality</hediff>
            <weight>0.8</weight>
          </li>
          <li>
            <hediff>DD_GachaBuff_Fortune</hediff>
            <weight>0.6</weight>  <!-- 稀有祝福，权重最低 -->
          </li>
        </hediffPool>
        
        <!-- 每次抽取的选项数量（三选一） -->
        <choiceCount>3</choiceCount>
        
        <!-- 使用权重进行随机抽取 -->
        <useWeights>true</useWeights>
        
        <!-- 不允许同一次抽取出现重复选项 -->
        <allowDuplicates>false</allowDuplicates>
        
        <!-- 窗口标题翻译键 -->
        <windowTitle>DD_HediffGacha_Title</windowTitle>
        
        <!-- 不允许取消选择（必须选一个） -->
        <allowCancel>false</allowCancel>
        
        <!-- 显示选择结果消息 -->
        <showSelectionMessage>true</showSelectionMessage>
        
        <!-- 如果目标已有该Hediff则替换 -->
        <replaceExisting>true</replaceExisting>
      </li>
    </comps>
  </AbilityDef>

  <!-- 切换护盾的技能 -->
  <AbilityDef>
    <defName>DD_Light_The_Lantern</defName>
    <label>Lantern Shield</label>
    <description>Light up the lantern carried by Michelle. The light emitted by this lantern will converge into a faintly visible shield, which can block incoming damage. The lamp oil is limited, and it can only protect Michelle for a while before it goes out, requiring it to be re-lit.</description>
    <iconPath>DivineDiurganate/UI/Abilities/DD_Light_The_Lantern</iconPath>
    <displayOrder>300</displayOrder>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>6000</cooldownTicksRange> <!-- 1秒冷却 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <targetRequired>false</targetRequired>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>3</warmupTime>
      <range>0</range>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="DivineDiurganate.CompProperties_AbilityToggleAdaptiveShield">
        <shieldHediffDef>DD_Lantern_Shield_Active</shieldHediffDef>
        <activateMessage>DD_Lantern_Shield_ActivatedMessage</activateMessage>
        <deactivateMessage>DD_Lantern_Shield_DeactivatedMessage</deactivateMessage>
      </li>
    </comps>
  </AbilityDef>
</Defs>