<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <PreceptDef ParentName="PreceptRoleSingleBase">
    <defName>DD_IdeoRole_Clergy</defName>
    <label>Diurganate Clergy</label>
    <description>The Clergy of Diurganate is a very important position in the church, which is not generally devoted to missionary duties, but to the maintenance of various equipment and mechanical artifacts in the Diurganate and to the conduct of a series of consecration ceremonies.</description>
    <iconPath>DivineDiurganate/UI/Roles/DD_IdeoRole_Clergy</iconPath>
    <nameMaker>DD_NamerRoleClergy</nameMaker>
    <canRemoveInUI>false</canRemoveInUI>
    <roleRequirements>
      <li Class="RoleRequirement_MinSkillAny">
        <skills>
          <Crafting>8</Crafting>
        </skills>
      </li>
    </roleRequirements>
    <roleRequiredWorkTagAny>
      <li>Crafting</li>
    </roleRequiredWorkTagAny>
    <roleTags>
      <li>Moralist</li>
    </roleTags>
    <requiredMemes>
      <li>DD_law_Meme</li>
    </requiredMemes>
    <roleEffects>
      <!-- <li Class="RoleEffect_PawnStatOffset">
        <statDef>ConstructionSpeed</statDef>
        <modifier>0.5</modifier>
      </li>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>WorkSpeedGlobal</statDef>
        <modifier>0.5</modifier>
      </li> -->
      <li Class="RoleEffect_ProductionQualityOffset">
        <offset>2</offset>
      </li>
    </roleEffects>
    <!-- 双尾教神职的技能 -->
    <grantedAbilities>
      <!-- <li>Convert</li>
      <li>Counsel</li>
      <li>Reassure</li>
      <li>ConversionRitual</li>
      <li>PreachHealth</li> -->
    </grantedAbilities>
    <displayOrderInImpact>2</displayOrderInImpact>
    <roleDisabledWorkTags>
      <li>ManualDumb</li>
      <li>Animals</li>
      <li>Cooking</li>
      <li>PlantWork</li>
      <li>Mining</li>
    </roleDisabledWorkTags>
  </PreceptDef>
  <RulePackDef>
    <defName>DD_NamerRoleClergy</defName>
    <rulePack>
      <rulesStrings>
        <li>r_roleName(p=4)->[memeClergy]</li>
        <li>r_roleName(p=2)->[memeAdjective] [memeClergy]</li>
        <li>r_roleName->[memeClergy] of [chosenTheme]</li>
        <li>r_roleName->[memeClergy] of [keyDeity]</li>
        <li>r_roleName->[memeClergy] of [memeConcept]</li>
        <li>r_roleName->[memeClergy] of [chosenIdeoName]</li>
        <li>r_roleName->[chosenAdjective] [memeClergy]</li>
        <li>r_roleName->[keyDeity]'s [memeClergy]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <AbilityGroupDef>
    <defName>ExorcistAbilityGroup</defName>
    <cooldownTicks>30000</cooldownTicks>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <ritualRoleIds>
      <li>speaker</li>
    </ritualRoleIds>
  </AbilityGroupDef>
  <AbilityDef>
    <defName>DD_Moralist_PrewarSpeech</defName>
    <label>Pre-battle Sermon</label>
    <description>The Moralist of DivineDiurganate deliver a pre-battle sermon for the upcoming battle, and each participant will receive a divine blessing based on the quality of the speech, making them braver and more difficult to kill on the battlefield. The quality of the speech is related to the social attributes of the exorcist.</description>
    <groupDef>ExorcistAbilityGroup</groupDef>
    <iconPath>UI/Abilities/LeaderSpeech</iconPath>
    <showWhenDrafted>false</showWhenDrafted>
    <hotKey>Misc12</hotKey>
    <gizmoClass>Command_AbilitySpeech</gizmoClass>
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
    <targetRequired>False</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Talking</capacity>
      </li>
      <li Class="CompProperties_AbilityStartRitual">
        <ritualDef>DD_Moralist_PrewarSpeech</ritualDef>
        <allowedForChild>false</allowedForChild>
      </li>
    </comps>
  </AbilityDef>
  <PreceptDef>
    <defName>DD_Moralist_PrewarSpeech</defName>
    <label>Pre-battle Sermon</label>
    <description>The Moralist of DivineDiurganate deliver a pre-battle sermon for the upcoming battle, and each participant will receive a divine blessing based on the quality of the speech, making them braver and more difficult to kill on the battlefield. The quality of the speech is related to the social attributes of the exorcist.</description>
    <issue>Ritual</issue>
    <preceptClass>Precept_Ritual</preceptClass>
    <visible>false</visible>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <selectionWeight>1.0</selectionWeight>
    <ritualPatternBase>DD_Moralist_PrewarSpeech</ritualPatternBase>
    <iconPath>UI/Abilities/LeaderSpeech</iconPath>
    <ignoreNameUniqueness>true</ignoreNameUniqueness>
    <useCooldownFromAbilityGroupDef>ExorcistAbilityGroup</useCooldownFromAbilityGroupDef>
    <iconIgnoresIdeoColor>true</iconIgnoresIdeoColor>
    <sourcePawnRoleDef>IdeoRole_Moralist</sourcePawnRoleDef>
    <sourceAbilityDef>DD_Moralist_PrewarSpeech</sourceAbilityDef>
    <classicExtra>true</classicExtra>
    <classic>true</classic>
  </PreceptDef>
  <RitualPatternDef>
    <defName>DD_Moralist_PrewarSpeech</defName>
    <ritualBehavior>DD_Moralist_PrewarSpeech</ritualBehavior>
    <ritualObligationTargetFilter>AnyIdeoBuildingOrRitualSpot</ritualObligationTargetFilter>
    <ritualTargetFilter>IdeoBuildingOrRitualSpot</ritualTargetFilter>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualOnlyForIdeoMembers>true</ritualOnlyForIdeoMembers>
    <canMergeGizmosFromDifferentIdeos>false</canMergeGizmosFromDifferentIdeos>
    <ritualOutcomeEffect>DD_Moralist_PrewarSpeech_EndEffect</ritualOutcomeEffect>
  </RitualPatternDef>
  <RitualBehaviorDef>
    <defName>DD_Moralist_PrewarSpeech</defName>
    <workerClass>RitualBehaviorWorker_Speech</workerClass>
    <durationTicks>600</durationTicks>
    <letterTitle>{RITUAL_labelCap}</letterTitle>
    <letterText>{SPEAKER_labelShort} is currently performing {RITUAL_labelIndef}. If all goes well, {IDEOMEMBERS} will be inspired by {SPEAKER_labelShort}'s sermon to gain greater combat abilities for a period of time. Better results from the ritual will help {IDEOMEMBERS} gain even more abilities and grant them additional mood.</letterText>
    <roles>
      <li Class="RitualRoleTag">
        <label>Speaker</label>
        <tag>DD_Exorcist</tag>
        <id>speaker</id>
        <precept>IdeoRole_Moralist</precept>
        <required>True</required>
        <maxCount>1</maxCount>
        <countsAsParticipant>False</countsAsParticipant>
        <allowChild>false</allowChild>
        <mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
      </li>
    </roles>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <allowedSpectateSidesOverride>Vertical</allowedSpectateSidesOverride>
        <spectateDistanceOverride>1</spectateDistanceOverride>
        <spectatorsRequired>true</spectatorsRequired>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>speaker</roleId>
            <dutyDef>SpeakOnCell_Leader</dutyDef>
            <speakerInteraction>Speech_Leader</speakerInteraction>
            <customPositions>
              <li Class="RitualPosition_BesideThing" />
            </customPositions>
          </li>
        </roleBehaviors>
        <visualEffectDef>Speech</visualEffectDef>
      </li>
    </stages>
  </RitualBehaviorDef>
  <RitualOutcomeEffectDef>
    <defName>DD_Moralist_PrewarSpeech_EndEffect</defName>
    <description>Depending on the quality of the ritual, participants will receive an additional 4 days of mood and combat ability boosts.</description>
    <workerClass>RitualOutcomeEffectWorker_Speech</workerClass>
    <comps>
      <li Class="RitualOutcomeComp_PawnStatScaled">
        <label>Social level of {PAWN_labelShort}</label>
        <labelAbstract>Social level of Moralist</labelAbstract>
        <roleId>speaker</roleId>
        <statDef>SocialImpact</statDef>
        <curve>
          <points>
            <li>(0.2, 0.0)</li>
            <li>(0.6, 0.2)</li>
            <li>(1.0, 0.3)</li>
            <li>(1.5, 0.4)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>Number of Participant</label>
        <curve>
          <points>
            <li>(1,  0.07)</li>
            <li>(4,  0.22)</li>
            <li>(7,  0.33)</li>
            <li>(10, 0.4)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_RoomStat">
        <label>Room appearance</label>
        <statDef>Impressiveness</statDef>
        <curve>
          <points>
            <li>0,  0</li>
            <li>50,  0.1</li>
            <li>120, 0.2</li>
          </points>
        </curve>
      </li>
      <li Class="DivineDiurganate.RitualOutcomeComp_ApplyHediffToParticipants">
        <hediffToApply>DD_Moralist_PrewarSpeech_Hediff</hediffToApply>
        <severityPerQuality>1</severityPerQuality>
        <applyToAllParticipants>true</applyToAllParticipants>
        <requirePositiveQuality>true</requirePositiveQuality>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <label>Terrible</label>
        <chance>0.05</chance>
        <memory>DD_TerriblePreach</memory>
        <positivityIndex>-2</positivityIndex>
      </li>
      <li>
        <label>Uninspiring</label>
        <chance>0.15</chance>
        <memory>DD_UninspiringPreach</memory>
        <positivityIndex>-1</positivityIndex>
      </li>
      <li>
        <label>Encouraging</label>
        <chance>0.6</chance>
        <memory>DD_EncouragingPreach</memory>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <label>Inspirational</label>
        <chance>0.2</chance>
        <memory>DD_InspirationalPreach</memory>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>
  <HediffDef>
    <defName>DD_Moralist_PrewarSpeech_Hediff</defName>
    <label>Combat Motivation</label>
    <description>All creatures created, in heaven, on earth, beneath the earth, in the depths of the sea, and between heaven and earth, say, "May praise, honor, glory, and power be given to the holy double-tail forever and ever."</description>
    <defaultLabelColor>(0.52, 1, 0.95)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <minSeverity>0.01</minSeverity>
    <maxSeverity>1</maxSeverity>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>240000</disappearsAfterTicks>        <!-- 4 days -->
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statFactors>
          <ShootingAccuracyPawn>1.1</ShootingAccuracyPawn>
          <MeleeHitChance>1.1</MeleeHitChance>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.05</minSeverity>
        <statFactors>
          <RangedCooldownFactor>0.9</RangedCooldownFactor>
          <ShootingAccuracyPawn>1.2</ShootingAccuracyPawn>
          <AimingDelayFactor>0.9</AimingDelayFactor>
          <MeleeCooldownFactor>0.9</MeleeCooldownFactor>
          <MeleeHitChance>1.2</MeleeHitChance>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <statFactors>
          <RangedCooldownFactor>0.85</RangedCooldownFactor>
          <ShootingAccuracyPawn>1.35</ShootingAccuracyPawn>
          <AimingDelayFactor>0.85</AimingDelayFactor>
          <MeleeCooldownFactor>0.85</MeleeCooldownFactor>
          <MeleeHitChance>1.35</MeleeHitChance>
          <MeleeArmorPenetration>1.2</MeleeArmorPenetration>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <statFactors>
          <RangedCooldownFactor>0.75</RangedCooldownFactor>
          <ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>
          <AimingDelayFactor>0.75</AimingDelayFactor>
          <MeleeCooldownFactor>0.75</MeleeCooldownFactor>
          <MeleeHitChance>1.5</MeleeHitChance>
          <MeleeArmorPenetration>1.35</MeleeArmorPenetration>

          <IncomingDamageFactor>0.8</IncomingDamageFactor>
          <StaggerDurationFactor>0.25</StaggerDurationFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>