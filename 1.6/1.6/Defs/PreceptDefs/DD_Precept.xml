<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <PreceptDef ParentName="PreceptRoleSingleBase">
    <defName>DD_IdeoRole_Clergy</defName>
    <label>Diurganate Clergy</label>
    <description>The Clergy of Diurganate is a very important position in the church, which is not generally devoted to missionary duties, but to the maintenance of various equipment and mechanical artifacts in the Diurganate and to the conduct of a series of consecration ceremonies.</description>
    <iconPath>DivineDiurganate/UI/Roles/DD_IdeoRole_Clergy</iconPath>
    <nameMaker>DD_NamerRoleClergy</nameMaker>
    <canRemoveInUI>false</canRemoveInUI>
    <roleRequirements>
      <li Class="RoleRequirement_MinSkillAny">
        <skills>
          <Crafting>8</Crafting>
        </skills>
      </li>
    </roleRequirements>
    <roleRequiredWorkTagAny>
      <li>Crafting</li>
    </roleRequiredWorkTagAny>
    <roleTags>
      <li>Moralist</li>
    </roleTags>
    <requiredMemes>
      <li>DD_law_Meme</li>
    </requiredMemes>
    <roleEffects>
      <!-- <li Class="RoleEffect_PawnStatOffset">
        <statDef>ConstructionSpeed</statDef>
        <modifier>0.5</modifier>
      </li>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>WorkSpeedGlobal</statDef>
        <modifier>0.5</modifier>
      </li> -->
      <li Class="RoleEffect_ProductionQualityOffset">
        <offset>2</offset>
      </li>
    </roleEffects>
    <!-- 双尾教神职的技能 -->
    <grantedAbilities>
      <!-- <li>Convert</li>
      <li>Counsel</li>
      <li>Reassure</li>
      <li>ConversionRitual</li>
      <li>PreachHealth</li> -->
    </grantedAbilities>
    <displayOrderInImpact>2</displayOrderInImpact>
    <roleDisabledWorkTags>
      <li>ManualDumb</li>
      <li>Animals</li>
      <li>Cooking</li>
      <li>PlantWork</li>
      <li>Mining</li>
    </roleDisabledWorkTags>
  </PreceptDef>
  <PreceptDef ParentName="PreceptRoleSingleBase">
    <defName>DD_IdeoRole_Exorcist</defName>
    <label>Diurganate Exorcist</label>
    <description>The exorcists of Diurganate were generally taken on by the most fervent believers in the church, and it was not the standard cleric established by the Catholic Church, but still had a high degree of praise in civil societies, where they served as a benchmark for the removal of atrocities and the maintenance of order in the community, and because of the fervent faith, the holy word could be heard briefly on the battlefield.</description>
    <iconPath>DivineDiurganate/UI/Roles/DD_IdeoRole_Exorcist</iconPath>
    <nameMaker>DD_NamerRoleExorcist</nameMaker>
    <canRemoveInUI>false</canRemoveInUI>
    <roleRequirements>
      <li Class="RoleRequirement_MinSkillAny">
        <skills>
          <Melee>6</Melee>
          <Shooting>6</Shooting>
        </skills>
      </li>
    </roleRequirements>
    <roleRequiredWorkTags>
      <li>Violent</li>
    </roleRequiredWorkTags>
    <roleTags>
      <li>DD_Exorcist</li>
    </roleTags>
    <requiredMemes>
      <li>DD_law_Meme</li>
    </requiredMemes>
    <roleEffects>
      <!-- <li Class="RoleEffect_PawnStatOffset">
        <statDef>ConstructionSpeed</statDef>
        <modifier>0.5</modifier>
      </li>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>WorkSpeedGlobal</statDef>
        <modifier>0.5</modifier>
      </li> -->
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>ShootingAccuracyPawn</statDef>
        <modifier>5</modifier>
      </li>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>AimingDelayFactor</statDef>
        <modifier>-0.35</modifier>
      </li>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>MeleeHitChance</statDef>
        <modifier>5</modifier>
      </li>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>MeleeDodgeChance</statDef>
        <modifier>5</modifier>
      </li>
    </roleEffects>
    <!-- 双尾教神职的技能 -->
    <grantedAbilities>
      <li>DD_Exorcist_PrewarSpeech</li>
      <li>DD_Exorcist_ProduceSpeech</li>
    </grantedAbilities>
    <displayOrderInImpact>2</displayOrderInImpact>
    <roleDisabledWorkTags>
      <li>Crafting</li>
      <li>Cooking</li>
      <li>PlantWork</li>
      <li>Mining</li>
      <li>Constructing</li>
    </roleDisabledWorkTags>
  </PreceptDef>
  <RulePackDef>
