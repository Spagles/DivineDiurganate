  </PreceptDef>
  <PreceptDef ParentName="PreceptRoleSingleBase">
    <defName>DD_IdeoRole_Exorcist</defName>
    <label>双尾教驱魔人</label>
    <description>圣双尾教的驱魔人一般由教会中最狂热的信徒担当，它不是教廷规定的标准神职，但是在民间社团依然有很高的赞誉度，她们是社区中除暴安良、维护秩序的标杆，并且因为狂热的信仰，可以在战场上短暂地听到圣言。</description>
    <iconPath>DivineDiurganate/UI/Roles/DD_IdeoRole_Exorcist</iconPath>
    <nameMaker>NamerRoleBrawler</nameMaker>
    <roleRequirements>
      <li Class="RoleRequirement_MinSkillAny">
        <skills>
          <Melee>6</Melee>
          <Shooting>6</Shooting>
        </skills>
      </li>
    </roleRequirements>
    <roleRequiredWorkTags>
      <li>Violent</li>
    </roleRequiredWorkTags>
    <roleTags>
      <li>DD_IdeoRole_Exorcist</li>
    </roleTags>
    <requiredMemes>
      <li>DD_law_Meme</li>
    </requiredMemes>
    <roleEffects>
