<Defs>
  <AlienRace.AlienBackstoryDef ParentName="BaseRatkinBackStory">
    <defName>DD_Ratkin_Sister</defName>
    <slot>Adulthood</slot>
    <title>Diurganate Sister</title>
    <titleShort>Sister</titleShort>
    <description>[PAWN_nameDef] is a nun from the Divine Diurganate. Compared to the followers of various folk religions in the Ratkin Kingdom, the followers of the Diurganate are more radical, thus [PAWN_pronoun] is different from the nuns active in other Rat Kingdoms. As the leader of the Diurganate's small group of followers, [PAWN_pronoun] always inspires nearby followers with her passionate spirit and leads them in striving for common goals—whether it's building colonies, holding prayer gatherings, or judging the unbelievers.</description>
    <bodyTypeGlobal>Thin</bodyTypeGlobal>
    <bodyTypeMale>Thin</bodyTypeMale>
    <bodyTypeFemale>Thin</bodyTypeFemale>
    <skillGains>
      <Melee>1</Melee>
      <Medicine>4</Medicine>
      <Social>4</Social>
      <Artistic>2</Artistic>
    </skillGains>

    <!-- <workDisables>
      <li>Violent</li>
    </workDisables> -->

    <requiredWorkTags>Violent</requiredWorkTags>

    <forcedTraitsChance Inherit="False">
      <li>
        <defName Degree="2">Beauty</defName>
        <chance>100</chance>
      </li>
      <li>
        <defName Degree="0">Faith</defName>
        <chance>100</chance>
      </li>
    </forcedTraitsChance>

    <spawnCategories>
      <li>RatkinStory</li>
      <li>RatkinNoble</li>
      <!-- <li>RatkinPriest</li> -->
      <li>RatkinKingdom</li>
      <!-- <li>RatkinNonViolence</li> -->
      <!-- <li>RatkinFarm</li>
      <li>RatkinThief</li> -->
      <!-- <li>RatkinUneducated</li> -->
      <!-- <li>RatkinEliteDefender</li>
      <li>RatkinServant</li> -->
      <li>RatkinSoldier</li>
      <li>RatkinDefender</li>
      <!-- <li>RatkinGuardener</li> -->
      <!-- <li>RatkinKnight</li> -->
      <!-- <li>RatkinKnightCommander</li> -->
      <li>DD_RatkinDisciple</li>
      <li>DD_RatkinClergy</li>
    </spawnCategories>
    <passions>
      <Medicine>2</Medicine>
    </passions>
  </AlienRace.AlienBackstoryDef>

