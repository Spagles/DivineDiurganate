  <AlienRace.AlienBackstoryDef ParentName="BaseRatkinBackStory">
    <defName>DD_Ratkin_Adopted_Child</defName>
    <slot>Adulthood</slot>
    <title>Adopted Ratkin Child</title>
    <titleShort>Adopted Child</titleShort>
    <description>[PAWN_nameDef]是一名被收养的孩子。在某个风雨交加的夜晚，一对鼠族夫妇在路边看到了被遗弃的[PAWN_nameDef]，尽管她们是当地名流并且已经有一位女儿，[PAWN_pronoun]也不是鼠族，但是她们依然收养了[PAWN_nameDef]——对于狂热排外的双尾教国，这种行为是对信仰纯粹的玷污。为了在双尾教国的排外环境下生活，这对夫妇为其准备了栩栩如生的假耳朵和假尾巴，并让自己的女儿在外面保护[PAWN_possessive]，那个本该在风雨夜中死去的孩子，最终得到了一个温暖的家。</description>
    <bodyTypeGlobal>Thin</bodyTypeGlobal>
    <bodyTypeMale>Thin</bodyTypeMale>
		<bodyTypeFemale>Thin</bodyTypeFemale>
     <skillGains>
      <Melee>1</Melee>
      <Medicine>4</Medicine>
      <Social>4</Social>
			<Artistic>2</Artistic>
    </skillGains>

		<!-- <workDisables>
			<li>Violent</li>
		</workDisables> -->

    <requiredWorkTags>Violent</requiredWorkTags>

		<forcedTraitsChance Inherit="False">
