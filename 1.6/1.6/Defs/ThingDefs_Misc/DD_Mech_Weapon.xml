<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- melee -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>DD_DHM69_Scythe_Mech_Weapon</defName>
    <label>Huge Scythe</label>
    <description>Huge Scythe Made For DHM69.</description>
    <uiIconPath>DivineDiurganate/Weapon/DD_DHM69_Scythe_Mech_Weapon</uiIconPath>
	  <destroyOnDrop>true</destroyOnDrop>

    <generateCommonality>0.01</generateCommonality>
    <relicChance>0</relicChance>
    <tradeability>None</tradeability>
    <smeltable>false</smeltable>
    <thingSetMakerTags Inherit="False" />

    <techLevel>Industrial</techLevel>
    <weaponTags Inherit="False">
      <li>DD_DHM69_Scythe_Mech_Weapon</li>
    </weaponTags>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Mech_Weapon_Empty</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False" />
    <costList Inherit="False">
      <Steel>50</Steel>
    </costList>
    <statBases>
      <MarketValue>350</MarketValue>
      <WorkToMake>3000</WorkToMake>
      <Mass>35</Mass>
    </statBases>
    <tools Inherit="False">
      <li>
        <label>Scythe Slash</label>
        <capacities>
          <li>DD_DHM69_Scythe_Slash</li>
        </capacities>
        <power>40</power>
        <armorPenetration>2</armorPenetration>
        <cooldownTime>2.2</cooldownTime>
        <soundMeleeHit>DD_Mech_Scythe_Slash_Hit_Sound</soundMeleeHit>
        <soundMeleeMiss>DD_Mech_Scythe_Slash_Hit_Sound</soundMeleeMiss>
      </li>
    </tools>
    <recipeMaker>
      <recipeUsers Inherit="False" />
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
    <comps>
      <!-- 这里规定了该武器是什么机甲的武器，其他机甲和非机甲pawn无法拿起此武器 -->
      <!-- This specifies the mech whose weapon this is. Other mechs and non-mech pawns cannot pick up this weapon -->
      <li Class="DivineDiurganate.CompProperties_MechOnlyWeapon">
        <allowedMechRaces>
          <li>DD_DHM69_Scythe_Mech</li>
        </allowedMechRaces>
      </li>
      <!-- 造成范围伤害的近战攻击，我只是想让镰刀攻击看起来更帅一些才写了这些东西，本身并不是机甲系统必须的 -->
       <!-- A melee attack that deals area damage. I wrote these things just to make the scythe attack look cooler, and it's not essential to the mech system. -->
      <li Class="DivineDiurganate.CompProperties_Cleave">
        <cleaveAngle>90</cleaveAngle>
        <cleaveRange>4.5</cleaveRange>
        <cleaveDamageFactor>0.75</cleaveDamageFactor>
        <damageDowned>false</damageDowned>
        <explosionDamageDef>Cut</explosionDamageDef>
        <attackEffecter>DD_DHM69_Scythe_Slash_Hit</attackEffecter>
        <cleaveEffecter>DD_DHM69_Scythe_Slash_Hit</cleaveEffecter>
      </li>
    </comps>
  </ThingDef>
  <ToolCapacityDef>
    <defName>DD_DHM69_Scythe_Slash</defName>
    <label>Scythe Slash</label>
  </ToolCapacityDef>
  <ManeuverDef>
    <defName>DD_DHM69_Scythe_Slash</defName>
    <requiredCapacity>DD_DHM69_Scythe_Slash</requiredCapacity>
    <verb>
      <verbClass>DivineDiurganate.Verb_MeleeAttack_Cleave</verbClass>
      <meleeDamageDef>Cut</meleeDamageDef>
    </verb>
    <logEntryDef>MeleeAttack</logEntryDef>
    <combatLogRulesHit>Maneuver_Slash_MeleeHit</combatLogRulesHit>
    <combatLogRulesDeflect>Maneuver_Slash_MeleeDeflect</combatLogRulesDeflect>
    <combatLogRulesMiss>Maneuver_Slash_MeleeMiss</combatLogRulesMiss>
    <combatLogRulesDodge>Maneuver_Slash_MeleeDodge</combatLogRulesDodge>
  </ManeuverDef>

  <!-- ranged -->
  <ThingDef ParentName="BaseMakeableGrenade">
    <defName>DD_DHM86_Knell_Mech_Weapon</defName>
    <label>Winches Grenade Launcher</label>
    <description>The weapon of DHM86 Knell , which can launch powerful grenades to a distant location through a pair of winches.</description>
	  <destroyOnDrop>true</destroyOnDrop>
    
    <generateCommonality>0.01</generateCommonality>
    <relicChance>0</relicChance>
    <tradeability>None</tradeability>
    <smeltable>false</smeltable>
    <thingSetMakerTags Inherit="False" />

    <uiIconPath>DivineDiurganate/Mote/DD_DHM86_Knell_Mech_Weapon_Proj</uiIconPath>
    <uiIconScale>0.75</uiIconScale>
    <recipeMaker>
      <recipeUsers Inherit="False" />
    </recipeMaker>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Mech_Weapon_Empty</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <soundInteract>Interact_Grenade</soundInteract>
    <techLevel>Industrial</techLevel>
    <statBases>
      <Mass>1</Mass>
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
      <WorkToMake>12000</WorkToMake>
    </statBases>
    <costList>
      <Steel>20</Steel>
      <Chemfuel>80</Chemfuel>
    </costList>
    <weaponTags Inherit="False">
      <li>DD_DHM86_Knell_Mech_Weapon</li>
    </weaponTags>
    <thingCategories Inherit="False"/>
    <verbs>
      <li>
        <label>throw grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>28</range>
        <forcedMissRadius>0.25</forcedMissRadius>
        <warmupTime>0.75</warmupTime>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>DD_DHM86_Knell_Mech_Weapon_FireSound</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>DD_DHM86_Knell_Mech_Weapon_Proj</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <!-- 这里规定了该武器是什么机甲的武器，其他机甲和非机甲pawn无法拿起此武器 -->
      <!-- This specifies the mech whose weapon this is. Other mechs and non-mech pawns cannot pick up this weapon -->
      <li Class="DivineDiurganate.CompProperties_MechOnlyWeapon">
        <allowedMechRaces>
          <li>DD_DHM86_Knell_Mech</li>
        </allowedMechRaces>
      </li>
    </comps>
  </ThingDef>
  <ThingDef>
    <defName>DD_DHM86_Knell_Mech_Weapon_Proj</defName>
    <label>Grenade</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>DivineDiurganate/Mote/DD_DHM86_Knell_Mech_Weapon_Proj</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>0.5</drawSize>
    </graphicData>
    <category>Projectile</category>
    <altitudeLayer>Projectile</altitudeLayer>
    <tickerType>Normal</tickerType>
    <useHitPoints>False</useHitPoints>
    <neverMultiSelect>True</neverMultiSelect>
    <projectile>
      <speed>45</speed>
      <arcHeightFactor>2</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
      <explosionRadius>2.9</explosionRadius >
      <damageDef>Bomb</damageDef>
      <damageAmountBase>25</damageAmountBase>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="BaseMakeableGrenade">
    <defName>DD_DHM70_Rampart_Mech_Weapon</defName>
    <label>Anti-Mech Rapid Fire Cannon</label>
    <description>A pair of anti-mech rapid-fire cannons, designed specifically for the DHM70-Rampart, require the user to stand still before firing, but their offensive power is so fierce that they can tear apart even the most powerful enemy armored targets.</description>
	  <destroyOnDrop>true</destroyOnDrop>
    
    <generateCommonality>0.01</generateCommonality>
    <relicChance>0</relicChance>
    <tradeability>None</tradeability>
    <smeltable>false</smeltable>
    <thingSetMakerTags Inherit="False" />

    <!-- <uiIconPath>DivineDiurganate/Mote/DD_DHM86_Knell_Mech_Weapon_Proj</uiIconPath>
    <uiIconScale>0.75</uiIconScale> -->
    <recipeMaker>
      <recipeUsers Inherit="False" />
    </recipeMaker>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Mech_Weapon_Empty</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <soundInteract>Interact_Grenade</soundInteract>
    <techLevel>Industrial</techLevel>
    <statBases>
      <Mass>1</Mass>
      <WorkToMake>12000</WorkToMake>
      <AccuracyTouch>0.45</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.8</AccuracyMedium>
      <AccuracyLong>0.7</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>20</Steel>
      <Chemfuel>80</Chemfuel>
    </costList>
    <weaponTags Inherit="False">
      <li>DD_DHM70_Rampart_Mech_Weapon</li>
    </weaponTags>
    <thingCategories Inherit="False"/>
    <verbs>
      <li>
        <verbClass>DivineDiurganate.Verb_ShootWithOffset</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
        <warmupTime>1</warmupTime>
        <defaultProjectile>DD_DHM70_Rampart_Mech_Weapon_Bullet</defaultProjectile>
        <range>38.9</range>
        <burstShotCount>1</burstShotCount>
        <minRange>3.9</minRange>
        <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
        <soundCast>DD_DHM70_Rampart_Mech_Weapon_FireSound</soundCast>
        <canGoWild>false</canGoWild>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbs>
    <modExtensions>
      <li Class="DivineDiurganate.ModExtension_ShootWithOffset">
        <offsets>
          <li>(1.5, 0)</li>
          <li>(-1.5, 0)</li>
        </offsets>
      </li>
    </modExtensions>
    <comps>
      <!-- 这里规定了该武器是什么机甲的武器，其他机甲和非机甲pawn无法拿起此武器 -->
      <!-- This specifies the mech whose weapon this is. Other mechs and non-mech pawns cannot pick up this weapon -->
      <li Class="DivineDiurganate.CompProperties_MechOnlyWeapon">
        <allowedMechRaces>
          <li>DD_DHM70_Rampart_Mech</li>
        </allowedMechRaces>
      </li>
      <li Class="DivineDiurganate.CompProperties_ShootOffsetCounter"/>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>DD_DHM70_Rampart_Mech_Weapon_Bullet</defName>
    <label>Anti-Mech Shell</label>
    <thingClass>DivineDiurganate.Projectile_PenetratingBullet</thingClass>
    <modExtensions>
      <li Class="DivineDiurganate.PenetratingBullet_Extension">
        <maxHits>1</maxHits>
        <damageFalloff>0</damageFalloff>
        <preventFriendlyFire>true</preventFriendlyFire>
        <tailFleckDef>DD_Black_Smoke_Tail</tailFleckDef>
        <fleckDelayTicks>4</fleckDelayTicks>

        <impactEffecter>DD_Huge_Bullet_Hit_Effecter</impactEffecter>

        <!-- 爆炸参数 -->
        <enableExplosion>true</enableExplosion>
        <explodeOnGroundHit>true</explodeOnGroundHit>
        <explodeOnMaxPenetration>true</explodeOnMaxPenetration>
        <explodeOnFirstImpact>true</explodeOnFirstImpact>
      </li>
    </modExtensions>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>2</drawSize>
      <color>(194,117,67)</color>
    </graphicData>
    <projectile>
      <damageDef>DD_GiantBomb</damageDef>
			<damageAmountBase>30</damageAmountBase>
			<stoppingPower>5</stoppingPower>
			<armorPenetrationBase>2</armorPenetrationBase>
			<speed>65</speed>
      <explosionRadius>1.9</explosionRadius>
      <soundExplode>DD_DHM70_Rampart_Mech_Weapon_ExplosiveSound</soundExplode>
      <preExplosionSpawnSingleThingDef>Filth_BlastMark</preExplosionSpawnSingleThingDef>
    </projectile>
  </ThingDef>
  <DamageDef ParentName="Bomb">
    <defName>DD_GiantBomb</defName>
    <label>Giant Explosive</label>
    <defaultDamage>150</defaultDamage>
    <defaultStoppingPower>2.0</defaultStoppingPower>
    <defaultArmorPenetration>1.30</defaultArmorPenetration>
    <explosionCenterEffecter>DD_GiantBomb_Explosion</explosionCenterEffecter>
  </DamageDef>
  
  <!-- Turret -->
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>DD_DHM69_Scythe_MG_Turret</defName>
    <label>Machine Gun Turret</label>
    <description>Heavy machine gun loaded on DHM69.</description>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Mech_Weapon_Empty</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>10</Mass>
      <AccuracyTouch>0.2</AccuracyTouch>
      <AccuracyShort>0.25</AccuracyShort>
      <AccuracyMedium>0.25</AccuracyMedium>
      <AccuracyLong>0.18</AccuracyLong>
      <RangedWeapon_Cooldown>0.1</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>DD_DHM69_Scythe_MG_Turret_Proj</defaultProjectile>
        <range>21.9</range>
        <burstShotCount>24</burstShotCount>
        <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <defaultCooldownTime>0.1</defaultCooldownTime>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>DD_DHM69_Scythe_MG_Turret_Proj</defName>
    <label>minigun bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <color>(194,117,67)</color>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>4</damageAmountBase>
      <speed>70</speed>
      <armorPenetrationBase>1</armorPenetrationBase>
      <stoppingPower>0.2</stoppingPower>
    </projectile>
  </ThingDef>
</Defs>