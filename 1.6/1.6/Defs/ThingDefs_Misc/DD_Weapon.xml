<Defs>
  <!-- basic -->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>DD_Harpoon_Gun</defName>
    <label>Diurganate Harpoon Gun</label>
    <description>The weapon designed by the believers of Diurganate is not very efficient in its pneumatic system for launching harpoons, but at least it is relatively easy to wield as a spear.</description>
    <tickerType>Normal</tickerType>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Harpoon_Gun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <uiIconScale>0.7</uiIconScale>
    <recipeMaker>
      <!-- <recipeUsers Inherit="False" /> -->
			<researchPrerequisite>MicroOptical</researchPrerequisite>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
    <statBases>
      <WorkToMake>6000</WorkToMake>
      <Mass>2.5</Mass>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.75</AccuracyMedium>
			<AccuracyLong>0.65</AccuracyLong>
      <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
    </statBases>
    <costStuffCount>30</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
		<weaponTags Inherit="false">
			<li>RK_1TierWeapon</li>
			<li>RK_Rifle</li>
			<li>RK_Weapon</li>
			<li>RK_MeleeWeapon_Lance</li>
			<li>RK_LightWeapon</li>
			<li>DD_Skirmish_Weapon</li>
		</weaponTags>
    <generateCommonality>0.01</generateCommonality>
    <tradeability>None</tradeability>
    <thingSetMakerTags Inherit="False" />
		<tools Inherit="False">
			<li>
				<label>bayonet</label>
				<capacities>
					<li>Cut</li>
					<li>Stab</li>
				</capacities>
				<power>20</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
    <comps>
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>DD_Harpoon_Gun_Launch_Harpoon</abilityDef>
      </li>
			<li Class="RatkinWeapons.CompProperties_Bayonet" MayRequire="bbb.ratkinweapon.morefailure">
				<cooldown>1800</cooldown>
				<radius>14.9</radius>
				<label>RK.BayonetLabel</label>
				<description>RK.BayonetDescription</description>
				<icon>UI/Abilities/RK_Bayonet</icon>
			</li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>DD_Spear_Rifle</defName>
    <label>Crescent Axe Spear Rifle</label>
    <description>The standard weapon of Diurganate Crusader, equipped with a complete loading mechanism to continuously fire high damage harpoons from a distance. It also has a crescent axe blade attached, capable of splitting close range opponents into two pieces.</description>
    <tickerType>Normal</tickerType>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Spear_Rifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <uiIconScale>0.9</uiIconScale>
    <costStuffCount>50</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <recipeMaker>
      <!-- <recipeUsers Inherit="False" /> -->
			<researchPrerequisite>FlechetteBullet</researchPrerequisite>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
    <statBases>
      <WorkToMake>5000</WorkToMake>
      <Mass>1.4</Mass>
      <AccuracyTouch>0.65</AccuracyTouch>
      <AccuracyShort>0.8</AccuracyShort>
      <AccuracyMedium>0.5</AccuracyMedium>
      <AccuracyLong>0.4</AccuracyLong>
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
        <warmupTime>0.1</warmupTime>
        <defaultProjectile>DD_Spear_Rifle_Bullet</defaultProjectile>
        <range>27.9</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
        <soundCast>DD_Spear_Machinegun_FireSound</soundCast>
      </li>
    </verbs>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
		<weaponTags Inherit="false">
			<li>RK_3TierWeapon</li>
			<li>RK_Weapon</li>
			<li>RK_RangeWeapon</li>
			<li>DD_RatkinCrusader_Weapon</li>
			<li>DD_RatkinClergy_Weapon</li>
		</weaponTags>
    <generateCommonality>1</generateCommonality>
    <tradeability>None</tradeability>
    <thingSetMakerTags Inherit="False" />
    <tools Inherit="False">
      <li>
        <label>Axe Blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>21</power>
        <cooldownTime>2.25</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>DD_Spear_Rifle_Bullet</defName>
    <label>Spear</label>
    <thingClass>DivineDiurganate.Projectile_PenetratingBullet</thingClass>
    <modExtensions>
      <li Class="DivineDiurganate.PenetratingBullet_Extension">
        <maxHits>1</maxHits>        <!-- 无限穿透 -->
        <damageFalloff>1</damageFalloff>        <!-- 无伤害衰减 -->
        <preventFriendlyFire>true</preventFriendlyFire>        <!-- 是否阻止友方火力 -->
        <tailFleckDef>DD_GunTail_Lighting</tailFleckDef>        <!-- 拖尾特效定义 -->
        <fleckDelayTicks>2</fleckDelayTicks>

        <impactEffecter>DD_Harpoon_Bullet_Hit_Effecter</impactEffecter>
      </li>
    </modExtensions>
    <graphicData>
      <texPath>DivineDiurganate/Mote/DD_Spear_Rifle_Bullet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- <shaderType>MoteGlow</shaderType>
      <color>(194,117,67)</color> -->
    </graphicData>
    <projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>16</damageAmountBase>
			<stoppingPower>5</stoppingPower>
			<armorPenetrationBase>0.75</armorPenetrationBase>
			<speed>75</speed>
    </projectile>
  </ThingDef>
