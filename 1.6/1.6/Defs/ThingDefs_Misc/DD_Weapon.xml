<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>DD_Axe_Pistol</defName>
    <label>Diurganate Axe pistol</label>
    <description>The basic self-defense weapon used by the followers and clergy of the Diurganate has an axe blade fixed to the front of the barrel, allowing it to be used as an axe in close combat.</description>
    <tickerType>Normal</tickerType>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Axe_Pistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.75</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <uiIconScale>1.25</uiIconScale>
    <recipeMaker>
      <!-- <recipeUsers Inherit="False" /> -->
			<researchPrerequisite>MicroOptical</researchPrerequisite>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
    <statBases>
      <WorkToMake>5000</WorkToMake>
      <Mass>1.4</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.6</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
      <RangedWeapon_Cooldown>2.1</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
        <warmupTime>0.1</warmupTime>
        <defaultProjectile>DD_Axe_Pistol_Bullet</defaultProjectile>
        <range>27.9</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
        <soundCast>Shot_Revolver</soundCast>
      </li>
    </verbs>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
		<weaponTags Inherit="false">
			<li>RK_2TierWeapon</li>
			<li>RK_Weapon</li>
			<li>RK_RangeWeapon</li>
			<li>RK_Murderer</li>
			<!-- <li>DD_Weapon_T1</li> -->
			<li>DD_RatkinClergy_Weapon</li>
		</weaponTags>
    <generateCommonality>0.01</generateCommonality>
    <tradeability>None</tradeability>
    <thingSetMakerTags Inherit="False" />
    <tools Inherit="False">
      <li>
        <label>Gunstock</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>Axe Blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>DD_Axe_Pistol_Bullet</defName>
    <label>Pistol Bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <color>(194,117,67)</color>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <stoppingPower>2</stoppingPower>
      <speed>45</speed>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>DD_Harpoon_Gun</defName>
    <label>Diurganate Harpoon Gun</label>
    <description>The weapon designed by the believers of Diurganate is not very efficient in its pneumatic system for launching harpoons, but at least it is relatively easy to wield as a spear.</description>
    <tickerType>Normal</tickerType>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Harpoon_Gun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.25</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <uiIconScale>0.8</uiIconScale>
    <recipeMaker>
      <!-- <recipeUsers Inherit="False" /> -->
			<researchPrerequisite>MicroOptical</researchPrerequisite>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
    <statBases>
      <WorkToMake>6000</WorkToMake>
      <Mass>2.5</Mass>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.75</AccuracyMedium>
			<AccuracyLong>0.65</AccuracyLong>
      <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
		<weaponTags Inherit="false">
			<li>RK_2TierWeapon</li>
			<li>RK_Rifle</li>
			<li>RK_Weapon</li>
			<li>RK_RangeWeapon</li>
			<li>RK_LightWeapon</li>
			<li>RK_Combatant</li>
			<li>RK_Murderer</li>
			<li>DD_Weapon_T1</li>
		</weaponTags>
    <generateCommonality>0.01</generateCommonality>
    <tradeability>None</tradeability>
    <thingSetMakerTags Inherit="False" />
		<tools Inherit="False">
			<li>
				<label>bayonet</label>
				<capacities>
					<li>Cut</li>
					<li>Stab</li>
				</capacities>
				<power>20</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
    <comps>
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>DD_Harpoon_Gun_Launch_Harpoon</abilityDef>
      </li>
    </comps>
  </ThingDef>
  <AbilityDef>
    <defName>DD_Harpoon_Gun_Launch_Harpoon</defName>
    <label>发射鱼叉</label>
    <description>使用气动发射器，将威力强大的鱼叉发射出去——但是在重新装填前，鱼叉枪就只能当成近战武器使用了。</description>
    <iconPath>UI/Abilities/PiercingSpine</iconPath>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>34.9</range>
      <warmupTime>1</warmupTime>
      <soundCast>DD_Harpoon_Gun_FireSound</soundCast>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>DD_Harpoon_Gun_Bullet</projectileDef>
      </li>
    </comps>
  </AbilityDef>
  <ThingDef ParentName="BaseBullet">
    <defName>DD_Harpoon_Gun_Bullet</defName>
    <label>Harpoon</label>
    <graphicData>
      <texPath>DivineDiurganate/Mote/DD_Harpoon_Gun_Proj</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- <shaderType>MoteGlow</shaderType>
      <color>(194,117,67)</color> -->
    </graphicData>
    <projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>35</damageAmountBase>
			<stoppingPower>5</stoppingPower>
			<armorPenetrationBase>0.75</armorPenetrationBase>
			<speed>75</speed>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>DD_Fire_Shotgun</defName>
    <label>Holy Shotgun</label>
    <description>Although it's called a shotgun, don't be fooled - this thing is a real shotgun filled with brass cast blessed dragon pellets, enough for close range enemies to experience what "physical exorcism" is.</description>
    <tickerType>Normal</tickerType>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>DivineDiurganate/Weapon/DD_Fire_Shotgun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <recipeUsers Inherit="False" />
			<researchPrerequisite>MechanicalWeapon</researchPrerequisite>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
    <statBases>
      <WorkToMake>7500</WorkToMake>
      <Mass>2</Mass>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.75</AccuracyMedium>
			<AccuracyLong>0.65</AccuracyLong>
      <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li Class="DivineDiurganate.VerbProperties_FireSpew">
        <verbClass>DivineDiurganate.Verb_ShootFireSpew</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <warmupTime>0.5</warmupTime>
        <range>15</range>        <!-- Standard range property -->
        <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <!-- <soundCast>Shot_MiniFlameblaster</soundCast> -->
        <soundCast>Shot_Shotgun</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>

        <!-- Custom Properties for the modified Verb_SpewFire logic -->
        <degrees>25</degrees>
        <damageDef>Flame</damageDef>
        <damageAmount>12</damageAmount>
        <!-- <filthDef>Filth_SpentAcid</filthDef> -->
        <effecterDef>DD_Fire_Shotgun_Fire_Spew</effecterDef>
        <propagationSpeed>0.5</propagationSpeed>
        <chanceToStartFire>1</chanceToStartFire>
        <avoidFriendlyFire>false</avoidFriendlyFire>
      </li>
    </verbs>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
		<weaponTags Inherit="false">
			<li>RK_3TierWeapon</li>
			<li>RK_Weapon</li>
			<li>RK_RangeWeapon</li>
			<li>DD_Weapon_T2</li>
			<li>DD_RatkinClergy_Weapon</li>
			<li>DD_RatkinCrusaders_Weapon</li>
		</weaponTags>
    <generateCommonality>0.01</generateCommonality>
  </ThingDef>
  <EffecterDef>
    <defName>DD_Fire_Shotgun_Fire_Spew</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <positionRadius>0.15</positionRadius>
        <fleckDef>FireSpew_A</fleckDef>
        <chancePerTick>0.9</chancePerTick>
        <burstCount>5~10</burstCount>
        <speed>15.5</speed>
        <scale>0.8~1.2</scale>
        <angle>-20~20</angle>
        <positionLerpFactor>0.85</positionLerpFactor>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <positionRadius>0.1</positionRadius>
        <fleckDef>FireSpew_Base</fleckDef>
        <chancePerTick>0.1</chancePerTick>
        <speed>0.6</speed>
        <scale>0.8</scale>
        <angle>-7~7</angle>
        <positionLerpFactor>0.75</positionLerpFactor>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <positionRadius>0.1</positionRadius>
        <moteDef>Mote_SparkThrownFast</moteDef>
        <chancePerTick>0.5</chancePerTick>
        <speed>3.3~5</speed>
        <scale>0.1~0.2</scale>
        <angle>-12~12</angle>
        <positionLerpFactor>0.8</positionLerpFactor>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <positionRadius>0.2</positionRadius>
        <fleckDef>FireSpew_Glow</fleckDef>
        <chancePerTick>0.16</chancePerTick>
        <positionLerpFactor>0.65</positionLerpFactor>
      </li>
    </children>
  </EffecterDef>
</Defs>