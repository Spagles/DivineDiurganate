			<li>RK_Headgear</li>
		</thingCategories>
	</ThingDef>


	<ThingDef ParentName="DD_ApparelMakeableBase">
		<defName>DD_Suicide_Bomb</defName>
		<label>Martyr</label>
		<description>A bomb strapped to the body, worn close to the skin, can trigger a massive explosion with the slightest press.\n\n The Ratkin believers, hoping to die for their faith, must press the bomb themselves—not be ignited by enemy fire; this bomb will not explode upon impact.</description>
		<graphicData>
			<texPath>DivineDiurganate/Apparel/DD_Suicide_Bomb</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False"/>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
			<!-- <researchPrerequisite>RatkinClothing</researchPrerequisite> -->
			<recipeUsers Inherit="false">
				<li>RK_FueledSmithy</li>
				<li>RK_ElectricSmithy</li>
			</recipeUsers>		
		</recipeMaker>
		<costList>
			<Steel>10</Steel>
		</costList>
		<techLevel>Industrial</techLevel>
		<statBases>
			<MaxHitPoints>20</MaxHitPoints>
			<WorkToMake>2500</WorkToMake>
			<Mass>3</Mass>
			<Flammability>1</Flammability>
			<EquipDelay>1</EquipDelay>
		</statBases>
		<equippedStatOffsets>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
			</bodyPartGroups>
			<wornGraphicPath>DivineDiurganate/Apparel/DD_Suicide_Bomb</wornGraphicPath>
			<layers>
        <li>Shell</li>
			</layers>
			<tags>
				<li>DD_Suicide_Bomb</li>
			</tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <useWornGraphicMask>true</useWornGraphicMask>
		</apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
    <comps>
      <li Class="CompProperties_CauseHediff_Apparel">
        <hediff>DD_Suicide_Bomb_Hediff</hediff>
      </li>
    </comps>
	</ThingDef>
  
	<ThingDef ParentName="DD_ApparelMakeableBase">
		<defName>DD_Nun_Dress</defName>
		<label>Diurganate Nun Dress</label>
    <description>The uniforms worn by the nuns who serve the Holy Two-Tail are designed with battlefield practicality in mind, compared to the uniforms of ordinary ratkin Sister Dress, and are therefore more defensive—though they are still ultimately a cloth, not armor.</description>
    <graphicData>
			<texPath>DivineDiurganate/Apparel/DD_Nun_Dress</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costList>
			<DevilstrandCloth>20</DevilstrandCloth>
		</costList>
		<costStuffCount>35</costStuffCount>
		<stuffCategories>
			<li>Leathery</li>
			<li>Fabric</li>
		</stuffCategories>
		<techLevel>Industrial</techLevel>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToMake>25000</WorkToMake>
			<Mass>3</Mass>
			<Flammability>1</Flammability>
			<EquipDelay>1</EquipDelay>
      <StuffEffectMultiplierArmor>0.25</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
		</statBases>
		<equippedStatOffsets>
			<MedicalTendQuality>0.25</MedicalTendQuality>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Neck</li>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>DivineDiurganate/Apparel/DD_Nun_Dress</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
			</layers>
			<tags>
				<li>DD_RatkinClergy</li>
			</tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <useWornGraphicMask>true</useWornGraphicMask>
		</apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
		<recipeMaker>
			<researchPrerequisite>HighClassClothing</researchPrerequisite>
		</recipeMaker>
	</ThingDef>
