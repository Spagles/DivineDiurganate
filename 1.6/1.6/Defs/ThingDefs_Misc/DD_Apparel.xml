<Defs>
  <ThingDef Name="DD_ApparelMakeableBase" ParentName="ApparelMakeableBase" Abstract="True">
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
		<tradeTags>
			<li>RK_Apparel</li>
		</tradeTags>
		<thingCategories>
			<li>RK_Apparel</li>
		</thingCategories>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <apparel>
      <tags>
			  <li>RK_Apparel</li>
      </tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <useIngredientsForColor>false</useIngredientsForColor>
			<workSkill>Crafting</workSkill>
			<effectWorking>Tailor</effectWorking>
			<soundWorking>Recipe_Tailor</soundWorking>
			<recipeUsers Inherit="false">
				<li>RK_ElectricTailoringBench</li>
				<li>RK_HandTailoringBench</li>
			</recipeUsers>
    </recipeMaker>
    <statBases>
      <Mass>1</Mass>
      <WorkToMake>7000</WorkToMake>
      <StuffEffectMultiplierArmor>0.35</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>1</StuffEffectMultiplierInsulation_Heat>
    </statBases>
  </ThingDef>
	<ThingDef Name="DD_HatMakeableBase" ParentName="DD_ApparelMakeableBase" Abstract="True">
