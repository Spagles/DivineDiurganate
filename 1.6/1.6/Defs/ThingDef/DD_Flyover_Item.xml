      <explosionRadius>4</explosionRadius>
      <explosionDamage>DD_GiantBomb</explosionDamage>
      <explosionDamageFactor>0.1</explosionDamageFactor>
    </skyfaller>
    <comps>
      <li Class="DivineDiurganate.CompProperties_MoteEmitterNorthward">
