    <tab>DD_ResearchTab</tab>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="DD_techBase">
    <defName>DD_LV1_Base_Technology</defName>
    <label>双尾教国授权-等级1</label>
    <description>双尾教国授权-等级1。</description>
    <baseCost>100</baseCost>
    <researchViewX>0.00</researchViewX>
    <researchViewY>3.20</researchViewY>
