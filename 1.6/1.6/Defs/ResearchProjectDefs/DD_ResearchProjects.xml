<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ResearchTabDef>
    <defName>DD_ResearchTab</defName>
    <label>双尾科技</label>
    <generalTitle>双尾教国的科技</generalTitle>
    <generalDescription>由双尾教国开发的一系列强大的战争机械。</generalDescription>
  </ResearchTabDef>
  <ResearchProjectDef Abstract="True" Name="DD_techBase">
