<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <BiomeDef>
    <defName>DD_Hell_Biome</defName>
    <label>Hell</label>
    <description>Hell brought to the projection of the reality due to some taboo ritual. This area is filled with only flames, sulfur, and the putrid stench from the abyss, making it impassable.</description>
    <generatesNaturally>false</generatesNaturally>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <isExtremeBiome>true</isExtremeBiome>
    <constantOutdoorTemperature>300</constantOutdoorTemperature>
    <baseWeatherCommonalities>
      <DD_Hell_Weather>1</DD_Hell_Weather>
    </baseWeatherCommonalities>
    <canBuildBase>false</canBuildBase>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <texture>DivineDiurganate/Biomes/DD_Hell_Biome</texture>
    <impassable>true</impassable>
    <isBackgroundBiome>true</isBackgroundBiome>
  </BiomeDef>
</Defs>