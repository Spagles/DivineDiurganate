<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>DD_SHM86_Knell_Building</defName>
    <label>SHM86-Knell</label>
    <description>The skirmisher-type mech equipped with grenades , excels in striking groups of enemy troops at medium distances with high maneuverability.</description>
    <uiOrder>2040</uiOrder>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <size>(3,3)</size>
    <fillPercent>0.25</fillPercent>
    <pathCost>0</pathCost>
    <uiIconScale>0.5</uiIconScale>
    <graphicData>
      <drawSize>5.5</drawSize>
      <texPath>DivineDiurganate/Things/DD_SHM86_Knell/Naked_Thin_north</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
      <WorkToBuild>750</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False"/>
    <costList>
      <Steel>500</Steel>
      <Plasteel>250</Plasteel>
      <ComponentIndustrial>16</ComponentIndustrial>
    </costList>
    <rotatable>false</rotatable>
    <building>
      <isInert>true</isInert>
    </building>
    <designationCategory>Misc</designationCategory>
    <!-- 核心组件，用于在建造完成时销毁建筑以生成一个pawn -->
    <!-- Core comps, used to destroy the building upon completion to generate a pawn -->
    <comps>
      <li Class="DivineDiurganate.CompProperties_BuildToPawn">
        <pawnKindDef>DD_SHM86_Knell_Mech</pawnKindDef>
        <spawnCount>1</spawnCount>
        <inheritFaction>true</inheritFaction>
      </li>
    </comps>
  </ThingDef>
</Defs>