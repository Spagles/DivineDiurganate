<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>DD_HellDiveShrine</defName>
    <label>Hell Dive Shrine</label>
    <description>Hell Dive Shrine</description>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
		<altitudeLayer>Building</altitudeLayer>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>1</fillPercent>
    <size>(1,1)</size>
    <drawHighlight>true</drawHighlight>
    <tradeability>None</tradeability>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Misc/CommsConsole</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <costList>
      <Steel>50</Steel>
    </costList>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>5</Mass>
    </statBases>
    <tickerType>Normal</tickerType>
    <canOverlapZones>true</canOverlapZones>
    <hasInteractionCell>false</hasInteractionCell>
    <defaultPlacingRot>North</defaultPlacingRot>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <designationCategory>Misc</designationCategory>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <paintable>true</paintable>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="DivineDiurganate.CompProperties_GameConditionTeleporter">
        <conditionDef>DD_Hell_Condition</conditionDef>
        <worldRange>0</worldRange>
        <hideSource>false</hideSource>
        <preventConditionStacking>true</preventConditionStacking>
      </li>
      <li Class="DivineDiurganate.CompProperties_MapTeleporter">
        <areaSize>(13,13)</areaSize>
        <warmupTicks>0</warmupTicks>
        <daysPerDistance>0.1</daysPerDistance>
        <checkCanBuildBase>true</checkCanBuildBase>
        <!-- <warmupSound>TeleporterWarmup</warmupSound>
        <teleportSound>TeleporterActivate</teleportSound>
        <requiredResearch>MapTeleportation</requiredResearch> -->
      </li>
      <li Class="DivineDiurganate.CompProperties_WeatherShelter">
        <shelterSize>(13,13)</shelterSize>
        <shelterColor>(0,0,0,0)</shelterColor>
        <requiresPower>false</requiresPower>
        <minPowerToShelter>0</minPowerToShelter>
        <minHitPointsForShelter>0</minHitPointsForShelter>
        
        <!-- <activeEffecter></activeEffecter>
        <shelterActiveSound></shelterActiveSound>
        <shelterDeactivateSound></shelterDeactivateSound> -->
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="EtherealThingBase">
    <defName>DD_TeleportLandingMarker</defName>
    <label>Export Of Hell</label>
    <description>Export Of Hell</description>
    <thingClass>DivineDiurganate.TeleportLandingMarker</thingClass>
    <graphicData>
      <texPath>Wula/Building/WULA_Dropping_Building_Cleanzone_Plus</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <hasCustomRectForSelector>true</hasCustomRectForSelector>
    <drawerType>RealtimeOnly</drawerType>
    <drawOffscreen>true</drawOffscreen>
  </ThingDef>
  
  <ThingDef ParentName="BuildingBase">
    <defName>DD_Airship_CommsConsole</defName>
    <label>Airship Communication Station</label>
    <description>The communication station, used for communicate with the Oberon, a heavy airship owned by Diurganate.</description>
    <!-- <thingClass>Building_CommsConsole</thingClass> -->
    <graphicData>
      <texPath>Things/Building/Misc/CommsConsole</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5,4)</drawSize>
      <damageData>
        <rect>(0,0,3,1.8)</rect>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
      <shadowData>
        <volume>(3,0.5,2)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Flammability>0.6</Flammability>
    </statBases>
    <size>(2,2)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <defaultPlacingRot>South</defaultPlacingRot>
    <interactionCellOffset>(0,0,2)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2100</uiOrder>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="DivineDiurganate.CompProperties_FlyOverGenerator">
        <flyOverDef>DD_Flyover_AirShip</flyOverDef>
        
        <defaultSpeed>0.01</defaultSpeed>
        <defaultAltitude>15</defaultAltitude>
        
        <spawnContents>false</spawnContents>
        <!-- <contentThingDef>Medicine</contentThingDef>
        <contentCount>10</contentCount> -->
        
        <!-- <cooldownTicks>420000</cooldownTicks> -->
        <cooldownTicks>10</cooldownTicks>
        <useLimit>-1</useLimit>
        <label>Call Oberon Airship</label>
        <description>Send a signal to the Oberon Airship near the route, instructing it to proceed to the orbit above the colony.</description>
      </li>
      <li Class="DivineDiurganate.CompProperties_TradeTerminal">
        <maxTradeRange>99999</maxTradeRange>
        <requiresPower>true</requiresPower>
        <gizmoIconPath>UI/Commands/Trade</gizmoIconPath>
        <gizmoLabel>Airship Trade</gizmoLabel>
        <gizmoDesc>Initiate trade with the airships over the colonies. The trade rules are the same as those for orbital trade ships. You need to prepare an orbital trade beacon to send supplies.</gizmoDesc>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <tickerType>Normal</tickerType>
  </ThingDef>
</Defs>