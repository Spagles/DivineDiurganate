<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef Name="DD_Lantern_Shield_Hediff_Base" Abstract="True">
    <label>Lantern Shield</label>
    <description>The lantern carried by Michelle can erect a faintly visible shield to block incoming projectiles and melee slashes from the front. Once the incense in the lantern burns out, the shield will disappear.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 0.8, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>

    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>

    <!-- <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>DD_Light_The_Lantern</li>
        </abilityDefs>
      </li>
    </comps> -->
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Hediff_Base">
    <defName>DD_Lantern_Shield_Base</defName>

    <comps>
      <li Class="HediffCompProperties_RemoveIfOtherHediff">
        <hediffs>
          <li>DD_Lantern_Shield_Adv_Wider</li>
          <li>DD_Lantern_Shield_Adv_Longer</li>
          <li>DD_Lantern_Shield_Adv_Extrabuff</li>
        </hediffs>
      </li>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>DD_Light_The_Lantern</li>
          <li>DD_Upgrade_Lantern</li>
        </abilityDefs>
      </li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Hediff_Base">
    <defName>DD_Lantern_Shield_Adv_Wider</defName>

    <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>DD_Light_The_Lantern_Wider</li>
        </abilityDefs>
      </li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Hediff_Base">
