<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef Name="DD_Lantern_Shield_Hediff_Base" Abstract="True"><hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 0.8, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>

    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>

    <!-- <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>DD_Light_The_Lantern</li>
        </abilityDefs>
      </li>
    </comps> -->
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Hediff_Base">
    <defName>DD_Lantern_Shield_Base</defName>
    <label>Lantern Shield</label>
    <description>The lantern carried by Michelle can erect a faintly visible shield to block incoming projectiles and melee slashes from the front. Once the incense in the lantern burns out, the shield will disappear.</description>

    <comps>
      <li Class="HediffCompProperties_RemoveIfOtherHediff">
        <hediffs>
          <li>DD_Lantern_Shield_Adv_Wider</li>
          <li>DD_Lantern_Shield_Adv_Longer</li>
          <li>DD_Lantern_Shield_Adv_Extrabuff</li>
        </hediffs>
      </li>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>DD_Light_The_Lantern</li>
          <li>DD_Upgrade_Lantern</li>
        </abilityDefs>
      </li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Hediff_Base">
    <defName>DD_Lantern_Shield_Adv_Wider</defName>
    <label>Lantern Shield</label>
    <description>Install an additional diffuser for the lantern, creating a holy shield that can withstand incoming firepower from a larger area.</description>

    <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>DD_Light_The_Lantern_Wider</li>
        </abilityDefs>
      </li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Hediff_Base">
    <defName>DD_Lantern_Shield_Adv_Longer</defName>
    <label>Lantern Shield</label>
    <description>Replaced the lamp oil with one that can support a longer burning time, and this new oil ignites quickly, even on the battlefield.</description>

    <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>DD_Light_The_Lantern_Longer</li>
        </abilityDefs>
      </li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Hediff_Base">
    <defName>DD_Lantern_Shield_Adv_Extrabuff</defName>
    <label>Lantern Shield</label>
    <description>The light it emits can provide protection to nearby teammates and dispel the undead curse from the Hell Legion within its range.</description>

    <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>DD_Light_The_Lantern_Extrabuff</li>
        </abilityDefs>
      </li>
    </comps>
  </HediffDef>

  <HediffDef Name="DD_Lantern_Shield_Active_Base" Abstract="True">
    <label>Lantern Shield</label>
    <description>The lantern carried by Michelle can erect a faintly visible shield to block incoming projectiles and melee slashes from the front. Once the incense in the lantern burns out, the shield will disappear.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 0.8, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>

    <renderNodeProperties>
      <li>
        <debugLabel>AdaptiveShield</debugLabel>
        <workerClass>DivineDiurganate.PawnRenderNodeWorker_AdaptiveShield</workerClass>
        <texPath>DivineDiurganate/Apparel/DD_Lantern_Shield</texPath>
        <shaderTypeDef>Cutout</shaderTypeDef>
        <parentTagDef>Body</parentTagDef>
        <drawSize>1</drawSize>
        <baseLayer>0</baseLayer>
        <drawData>
          <dataNorth>
            <layer>-50</layer>
            <offset>(0, 0, -0.1)</offset>
          </dataNorth>
          <dataSouth>
            <!-- 提高层级以遮挡头部 -->
            <layer>100</layer>
            <offset>(0, 0, 0)</offset>
          </dataSouth>
          <dataEast>
            <!-- 向右：盾在左手（内侧），被身体遮挡 -->
            <layer>-50</layer>
            <offset>(0, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <!-- 向左：盾在左手（外侧），遮挡身体和头部 -->
            <layer>100</layer>
            <offset>(0, 0, 0)</offset>
            <flip>true</flip>
          </dataWest>
        </drawData>
      </li>
      <li>
        <debugLabel>AdaptiveShieldLight</debugLabel>
        <workerClass>DivineDiurganate.PawnRenderNodeWorker_AdaptiveShield</workerClass>
        <texPath>DivineDiurganate/Apparel/DD_Lantern_Shield_Light</texPath>
        <shaderTypeDef>MoteGlow</shaderTypeDef>
        <parentTagDef>Body</parentTagDef>
        <drawSize>1</drawSize>
        <baseLayer>0</baseLayer>
        <drawData>
          <dataNorth>
            <layer>-50</layer>
            <offset>(0, 0, -0.1)</offset>
          </dataNorth>
          <dataSouth>
            <!-- 提高层级以遮挡头部 -->
            <layer>100</layer>
            <offset>(0, 0, 0)</offset>
          </dataSouth>
          <dataEast>
            <!-- 向右：盾在左手（内侧），被身体遮挡 -->
            <layer>-50</layer>
            <offset>(0, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <!-- 向左：盾在左手（外侧），遮挡身体和头部 -->
            <layer>100</layer>
            <offset>(0, 0, 0)</offset>
            <flip>true</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Active_Base">
    <defName>DD_Lantern_Shield_Active</defName>

    <stages>
      <li>
        <label>active</label>
        <becomeVisible>true</becomeVisible>
        <statFactors>
          <Flammability>0</Flammability>
          <StaggerDurationFactor>0</StaggerDurationFactor>
        </statFactors>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_RemoveIfOtherHediff">
        <hediffs>
          <li>DD_Lantern_Shield_Adv_Wider</li>
          <li>DD_Lantern_Shield_Adv_Longer</li>
          <li>DD_Lantern_Shield_Adv_Extrabuff</li>
        </hediffs>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>9000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="DivineDiurganate.HediffCompProperties_AdaptiveShield">
        <baseDamageThreshold>9999</baseDamageThreshold>
        <maxDamageThreshold>9999</maxDamageThreshold>
        <thresholdIncreaseOnPenetration>0</thresholdIncreaseOnPenetration>
        <blockAngle>100</blockAngle>
        
        <showActivationMessage>true</showActivationMessage>
        <resetThresholdOnDeactivate>true</resetThresholdOnDeactivate>
        <blockEffecter>Interceptor_BlockedProjectile</blockEffecter>

        <thresholdDecayDelay>1200</thresholdDecayDelay>
        <thresholdDecayPerSecond>0</thresholdDecayPerSecond>
      </li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Active_Base">
    <defName>DD_Lantern_Shield_Active_Wider</defName>

    <stages>
      <li>
        <label>active</label>
        <becomeVisible>true</becomeVisible>
        <!-- 可选：护盾激活时的属性修改 -->
        <statFactors>
          <Flammability>0</Flammability>
          <StaggerDurationFactor>0</StaggerDurationFactor>
        </statFactors>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>9000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="DivineDiurganate.HediffCompProperties_AdaptiveShield">
        <baseDamageThreshold>9999</baseDamageThreshold>
        <maxDamageThreshold>9999</maxDamageThreshold>
        <thresholdIncreaseOnPenetration>0</thresholdIncreaseOnPenetration>
        <blockAngle>140</blockAngle>
        
        <showActivationMessage>true</showActivationMessage>
        <resetThresholdOnDeactivate>true</resetThresholdOnDeactivate>
        <blockEffecter>Interceptor_BlockedProjectile</blockEffecter>

        <thresholdDecayDelay>1200</thresholdDecayDelay>
        <thresholdDecayPerSecond>0</thresholdDecayPerSecond>
      </li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Active_Base">
    <defName>DD_Lantern_Shield_Active_Longer</defName>

    <stages>
      <li>
        <label>active</label>
        <becomeVisible>true</becomeVisible>
        <!-- 可选：护盾激活时的属性修改 -->
        <statFactors>
          <Flammability>0</Flammability>
          <StaggerDurationFactor>0</StaggerDurationFactor>
        </statFactors>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>18000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="DivineDiurganate.HediffCompProperties_AdaptiveShield">
        <baseDamageThreshold>9999</baseDamageThreshold>
        <maxDamageThreshold>9999</maxDamageThreshold>
        <thresholdIncreaseOnPenetration>0</thresholdIncreaseOnPenetration>
        <blockAngle>100</blockAngle>
        
        <showActivationMessage>true</showActivationMessage>
        <resetThresholdOnDeactivate>true</resetThresholdOnDeactivate>
        <blockEffecter>Interceptor_BlockedProjectile</blockEffecter>

        <thresholdDecayDelay>1200</thresholdDecayDelay>
        <thresholdDecayPerSecond>0</thresholdDecayPerSecond>
      </li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="DD_Lantern_Shield_Active_Base">
    <defName>DD_Lantern_Shield_Active_Extrabuff</defName>

    <stages>
      <li>
        <label>active</label>
        <becomeVisible>true</becomeVisible>
        <statOffsets>
          <MoveSpeed>2</MoveSpeed>
          <ShootingAccuracyPawn>5</ShootingAccuracyPawn>
          <MeleeHitChance>4</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <RestFallRateFactor>0</RestFallRateFactor>
          <Flammability>0</Flammability>
          <StaggerDurationFactor>0</StaggerDurationFactor>  
        </statFactors>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>9000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="DivineDiurganate.HediffCompProperties_AdaptiveShield">
        <baseDamageThreshold>9999</baseDamageThreshold>
        <maxDamageThreshold>9999</maxDamageThreshold>
        <thresholdIncreaseOnPenetration>0</thresholdIncreaseOnPenetration>
        <blockAngle>100</blockAngle>
        
        <showActivationMessage>true</showActivationMessage>
        <resetThresholdOnDeactivate>true</resetThresholdOnDeactivate>

        <blockEffecter>Interceptor_BlockedProjectile</blockEffecter>

        <thresholdDecayDelay>1200</thresholdDecayDelay>
        <thresholdDecayPerSecond>0</thresholdDecayPerSecond>
      </li>
      <li Class="DivineDiurganate.HediffCompProperties_GiveHediffsInRangeToPawnKind">
        <range>15</range>
        <hediff>DD_Holy_Radiance</hediff>
        <mote>Mote_PsychicLinkLine</mote>
        <hideMoteWhenNotDrafted>false</hideMoteWhenNotDrafted>
        <defaultSeverity>0.5</defaultSeverity>
        <onlyPawnsInSameFaction>false</onlyPawnsInSameFaction>
        <useDefaultForOtherPawnKinds>true</useDefaultForOtherPawnKinds>
        
        <!-- 配置不同PawnKindDef的严重性 -->
        <pawnKindSeverities>
          <li>
            <pawnKindDef>DD_Ratkin_HellLegion_Heretic</pawnKindDef>
            <severity>1.5</severity>
          </li>
        </pawnKindSeverities>
        
        <targetingParameters>
          <canTargetAnimals>true</canTargetAnimals>
          <canTargetHumans>true</canTargetHumans>
          <canTargetMechs>true</canTargetMechs>
        </targetingParameters>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>DD_Holy_Radiance</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>Holy Radiance</label>
    <description>The holy light of the Twin-Tail shines upon this creature, enhancing both living beings and Mechanoid, and dispelling the unclean forces of the Hell Legion, rendering them vulnerable to damage from ordinary weapons.</description>
    <!-- <initialSeverity>0.5</initialSeverity> -->
    <minSeverity>0.01</minSeverity>
    <maxSeverity>2</maxSeverity>
    <alwaysShowSeverity>false</alwaysShowSeverity>
    <isBad>false</isBad>
    <duplicationAllowed>true</duplicationAllowed>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>1.1</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.5</postFactor>
          </li>
        </capMods>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90</disappearsAfterTicks> 
        <showRemainingTime>false</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_Link">
        <requireLinkOnOtherPawn>false</requireLinkOnOtherPawn>
        <maxDistance>15</maxDistance>
        <!-- <customMote>Mote_WorkCommandLinkLine</customMote> -->
      </li>
    </comps>
  </HediffDef>
</Defs>