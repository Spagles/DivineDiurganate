<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThoughtDef>
    <defName>DD_TerriblePreach</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>糟糕的布道</label>
        <description>那个布道讲的实在太糟糕了，简直就像是异端一样玷污信仰！</description>
        <baseMoodEffect>-3</baseMoodEffect>
        <baseOpinionOffset>-30</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>DD_UninspiringPreach</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>无聊的布道</label>
        <description>圣双尾鼠在上！为什么我们要浪费时间去听一只呆头鼠讲话？</description>
        <baseMoodEffect>-1</baseMoodEffect>
        <baseOpinionOffset>-15</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>DD_EncouragingPreach</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>受到布道的鼓舞</label>
        <description>我虽然行过死荫的幽谷，也不怕遭害。因为你与我同在。你的杖，你的竿，都安慰我。</description>
        <baseMoodEffect>3</baseMoodEffect>
        <baseOpinionOffset>20</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>DD_InspirationalPreach</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>醍醐灌顶的布道</label>
        <description>愿平安，仁爱，信心，从主圣双尾鼠，归与鼠众！</description>
        <baseMoodEffect>5</baseMoodEffect>
        <baseOpinionOffset>40</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
</Defs>