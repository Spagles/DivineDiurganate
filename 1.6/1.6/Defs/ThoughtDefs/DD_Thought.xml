<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThoughtDef>
    <defName>DD_TerriblePreach</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>Terrible Preach</label>
        <description>That preaching was absolutely terrible; it was like heresy, a defilement of faith!</description>
        <baseMoodEffect>-3</baseMoodEffect>
        <baseOpinionOffset>-30</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>DD_UninspiringPreach</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>Uninspiring Preach</label>
        <description>By the Holy Twin-Tail! Why should we waste our time listening to a silly preach?</description>
        <baseMoodEffect>-1</baseMoodEffect>
        <baseOpinionOffset>-15</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>DD_EncouragingPreach</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>Encouraging Preach</label>
        <description>Even though I walk through the valley of the shadow of death, I will fear no evil, for you are with me; your rod and your staff, they comfort me.</description>
        <baseMoodEffect>3</baseMoodEffect>
        <baseOpinionOffset>20</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>DD_InspirationalPreach</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>Inspirational Preach</label>
        <description>Peace, love, and faith from the Lord the two-tailed rat to all the Ratkins!</description>
        <baseMoodEffect>5</baseMoodEffect>
        <baseOpinionOffset>40</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
</Defs>